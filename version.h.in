#ifndef VERSION_H
#define VERSION_H

// Auto-generated version information
#define ENERGY_MANAGER_VERSION_MAJOR @CONFIG_ENERGY_MANAGER_VERSION_MAJOR@
#define ENERGY_MANAGER_VERSION_MINOR @CONFIG_ENERGY_MANAGER_VERSION_MINOR@
#define ENERGY_MANAGER_VERSION_PATCH @CONFIG_ENERGY_MANAGER_VERSION_PATCH@

#define ENERGY_MANAGER_VERSION_STRING "@CONFIG_ENERGY_MANAGER_VERSION_MAJOR@.@CONFIG_ENERGY_MANAGER_VERSION_MINOR@.@CONFIG_ENERGY_MANAGER_VERSION_PATCH@"

// Build information (filled by CMake)
#define BUILD_DATE __DATE__
#define BUILD_TIME __TIME__

// Git information (if available)
#ifndef GIT_COMMIT_HASH
#define GIT_COMMIT_HASH "unknown"
#endif

#ifndef GIT_BRANCH
#define GIT_BRANCH "unknown"
#endif

#endif // VERSION_H